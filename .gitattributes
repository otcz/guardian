# Normaliza finales de linea: LF en el repo, nativo en el working tree.
* text=auto

*.java   text eol=lf
*.xml    text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.ts     text eol=lf
*.html   text eol=lf
*.scss   text eol=lf
*.sql    text eol=lf
*.sh     text eol=lf
*.ps1    text eol=crlf
Dockerfile text eol=lf

*.png    binary
*.jpg    binary
*.jpeg   binary
*.ico    binary
*.pdf    binary
