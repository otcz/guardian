# Copia este archivo como infra/.env y ajusta lo que necesites.
# infra/.env esta en .gitignore — nunca se sube al repo.

# Origenes permitidos por CORS (CSV). Agrega la IP de tu equipo si vas a
# probar la app desde el celular en la misma red.
GUARDIAN_ALLOWED_ORIGINS=http://localhost:4200

# Secretos. Minimo 32 caracteres cada uno.
# Generar con: openssl rand -base64 32
GUARDIAN_JWT_SECRET=guardian-local-dev-secret-change-me-32b!

# OJO: si cambias esta clave, TODOS los QR emitidos dejan de validar y hay que
# reemitirlos uno por uno. No la rotes sin un plan.
GUARDIAN_QR_HMAC_SECRET=guardian-local-qr-hmac-change-me-32bytes!

# Administrador inicial. La clave arranca igual al documento y el sistema
# obliga a cambiarla en el primer ingreso.
GUARDIAN_ADMIN_DOCUMENTO=1000000000
GUARDIAN_CONJUNTO_NOMBRE=Conjunto Residencial
