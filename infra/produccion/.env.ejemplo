# ============================================================================
# GUARDIAN — variables del stack de produccion
# ============================================================================
# El archivo REAL vive en /data/guardian/.env con modo 600, FUERA del
# repositorio, igual que el de hermes en /data/compose/.env. Este de aca es
# solo la plantilla y es el unico de los dos que entra a git.
#
# Los secretos se generan una vez en el servidor y no salen de ahi:
#
#   openssl rand -base64 48
#
# ============================================================================

# ── Base de datos ───────────────────────────────────────────────────────────
GUARDIAN_DB_NOMBRE=guardian
GUARDIAN_DB_USUARIO=guardian
GUARDIAN_DB_CLAVE=

# ── Secretos de la aplicacion ───────────────────────────────────────────────
# Firman las sesiones. Cambiarlo cierra la sesion de todo el mundo, nada mas.
GUARDIAN_JWT_SECRET=

# Firma los codigos QR. CAMBIARLO INVALIDA TODOS LOS QR YA EMITIDOS y hay que
# reemitirlos uno por uno. No se rota salvo que se sepa comprometido.
GUARDIAN_QR_HMAC_SECRET=

# ── Cuenta inicial ──────────────────────────────────────────────────────────
# La UNICA que siembra el sistema. Un GUARDIAN nuevo arranca sin sedes: el
# super administrador las crea desde el panel. Si la clave se deja vacia o en
# su valor por defecto, la cuenta nace con cambio obligatorio en el primer
# ingreso.
GUARDIAN_SUPER_ADMIN_DOCUMENTO=SUPERADMIN
GUARDIAN_SUPER_ADMIN_CLAVE=

# ── Entorno ─────────────────────────────────────────────────────────────────
GUARDIAN_ZONA_HORARIA=America/Bogota

# Origenes permitidos (CSV). El navegador siempre habla con el mismo origen
# que le sirvio la pagina, asi que esto solo hace falta para llamar al API
# desde fuera — probar con curl, o una pantalla servida desde otro sitio.
GUARDIAN_ALLOWED_ORIGINS=https://guardiaco.com,https://www.guardiaco.com,https://jfzambrano.tailb456ca.ts.net:8443

# ── Salida a internet ───────────────────────────────────────────────────────
# Token del tunel de Cloudflare. Lo entrega el panel al crear el tunel y VALE
# POR SI SOLO: quien lo tenga puede conectar un tunel con ese nombre. Va aca y
# en ningun otro lado.
#
#   Cloudflare > Zero Trust > Networks > Tunnels > Create a tunnel
#
# Vacio = el contenedor del tunel no puede arrancar y se reinicia en bucle.
GUARDIAN_CLOUDFLARE_TOKEN=

# ── Correo ──────────────────────────────────────────────────────────────────
# Unico canal de recuperacion de clave. SIN configurar, el sistema arranca
# igual y el codigo se escribe en el log en vez de enviarse.
# Con Gmail la clave NO es la de la cuenta sino una "contrasena de aplicacion"
# de 16 letras, que exige tener la verificacion en dos pasos activada.
GUARDIAN_SMTP_HOST=
GUARDIAN_SMTP_PUERTO=587
GUARDIAN_SMTP_USUARIO=
GUARDIAN_SMTP_CLAVE=
GUARDIAN_CORREO_REMITENTE=no-responder@guardian.local
GUARDIAN_CORREO_NOMBRE=GUARDIAN

# ── Respaldos ───────────────────────────────────────────────────────────────
GUARDIAN_RETENCION_RESPALDOS=14
