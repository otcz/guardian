# ─────────────────────────────────────────────────────────────────────────────
# Plantilla de infra/.env
#
# COPIA este archivo a infra/.env y llena los valores. El .env real esta en
# .gitignore; ESTE, que es la plantilla, si se commitea — por eso no lleva
# ningun secreto de verdad.
#
#     cp infra/.env.ejemplo infra/.env
#
# ─────────────────────────────────────────────────────────────────────────────

# ── Correo ───────────────────────────────────────────────────────────────────
# Unico canal de recuperacion de clave. Si lo dejas vacio, el sistema arranca
# igual y el codigo se escribe en el log del backend en vez de enviarse — util
# para desarrollar sin cuenta SMTP.
#
# GMAIL: la clave NO es la de tu cuenta. Google dejo de aceptarla para SMTP en
# mayo de 2022. Necesitas una CONTRASENA DE APLICACION:
#
#   1. Activa la verificacion en dos pasos en tu cuenta de Google.
#   2. Entra a https://myaccount.google.com/apppasswords
#   3. Genera una para "Correo". Son 16 letras, en 4 grupos de 4.
#   4. Pegala abajo SIN espacios.
#
# Gmail limita a ~500 correos al dia, de sobra para un conjunto. Si algun dia
# no alcanza, Brevo da 300/dia gratis y esta pensado para envio transaccional.
GUARDIAN_SMTP_HOST=smtp.gmail.com
GUARDIAN_SMTP_PUERTO=587
GUARDIAN_SMTP_USUARIO=tucorreo@gmail.com
GUARDIAN_SMTP_CLAVE=pega-aqui-la-clave-de-aplicacion
GUARDIAN_CORREO_REMITENTE=tucorreo@gmail.com
GUARDIAN_CORREO_NOMBRE=GUARDIAN

# ── Zona horaria ─────────────────────────────────────────────────────────────
# La aplicacion la fija antes de arrancar. Solo cambiala si el conjunto NO esta
# en Colombia: las fechas ya guardadas se interpretarian con la zona nueva y se
# correrian tantas horas como diferencia haya.
GUARDIAN_ZONA_HORARIA=America/Bogota

# ── Secretos de firma ────────────────────────────────────────────────────────
# Minimo 32 bytes cada uno. Son DISTINTOS a proposito: comprometer la sesion de
# un usuario no debe permitir fabricar credenciales de acceso.
#
# OJO: si cambias el de QR, TODOS los codigos emitidos dejan de validar y hay
# que reemitirlos persona por persona.
GUARDIAN_JWT_SECRET=
GUARDIAN_QR_HMAC_SECRET=

# ── Cuenta inicial ───────────────────────────────────────────────────────────
# La UNICA que siembra el sistema. Si dejas la clave por defecto, la cuenta
# nace con cambio obligatorio en el primer ingreso.
GUARDIAN_SUPER_ADMIN_DOCUMENTO=SUPERADMIN
GUARDIAN_SUPER_ADMIN_CLAVE=

# ── Otros ────────────────────────────────────────────────────────────────────
GUARDIAN_ALLOWED_ORIGINS=http://localhost:4200
