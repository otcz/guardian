<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>guardian</groupId>
    <artifactId>guardian-api</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>guardian-api</name>
    <description>GUARDIAN - API de control de acceso residencial</description>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.18</version>
        <relativePath/>
    </parent>

    <properties>
        <java.version>1.8</java.version>
        <!-- Sin esto Maven compila con el encoding de CADA maquina: el Windows
             del desarrollo y el contenedor de produccion no coinciden, asi que
             una tilde escrita en un texto se veia bien en un lado y rota en el
             otro. Por eso todo el codigo estaba en ASCII, evitando el problema
             en vez de resolverlo — y los correos le llegaban al residente
             diciendo "contrasena". -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- Overrides de CVE. Mantener sincronizado con el pom raiz. -->
        <!-- Tomcat: CVE-2025-24813 CRITICAL (RCE), CVE-2024-34750 HIGH -->
        <tomcat.version>9.0.106</tomcat.version>
        <!-- Spring Framework: CVE-2024-22243/22259/22262 HIGH (SSRF), CVE-2024-38809 HIGH (DoS) -->
        <spring-framework.version>5.3.39</spring-framework.version>
        <!-- Spring Security: CVE-2025-22228 HIGH (BCrypt password length bypass) -->
        <spring-security.version>5.7.14</spring-security.version>
        <!-- SnakeYAML: CVE-2022-1471 HIGH (RCE deserialization) -->
        <snakeyaml.version>2.0</snakeyaml.version>
        <!-- Jackson: CVE-2025-52999 HIGH (StackOverflow DoS) -->
        <jackson-bom.version>2.17.2</jackson-bom.version>
        <!-- PostgreSQL: CVE-2024-1597 CRITICAL (SQL Injection via simple query mode) -->
        <postgresql.version>42.7.2</postgresql.version>
    </properties>

    <dependencies>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
            Correo. Es el unico canal de recuperacion de clave: SMTP contra un
            proveedor gratuito alcanza de sobra para un conjunto, y no agrega
            costo mensual como si lo harian el SMS o la API de WhatsApp.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- JWT: emision y verificacion del token de sesion (HS256). -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.11.5</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.11.5</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.11.5</version>
            <scope>runtime</scope>
        </dependency>

        <!-- ZXing: render del QR como PNG desde el servidor.
             No es para la app del residente (esa dibuja el QR en el cliente),
             sino para que el administrador imprima carnets: en un conjunto
             siempre hay residentes sin smartphone — adultos mayores sobre todo —
             y sin credencial impresa quedarian fuera del sistema. -->
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>core</artifactId>
            <version>3.5.3</version>
        </dependency>
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>javase</artifactId>
            <version>3.5.3</version>
        </dependency>

        <!-- Cache in-memory para el estado de sesion y el freno de fuerza bruta
             del login. Es el default economico del proyecto (CLAUDE.md seccion
             8): nada de Redis. Linea 2.x porque 3.x exige Java 11+. -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
            <version>2.9.3</version>
        </dependency>

        <!-- Excel para la carga masiva de casas. fastexcel y NO Apache POI:
             POI pesa ~15 MB con sus dependencias y carga el libro entero en
             memoria; fastexcel pesa ~1.7 MB y lo lee en streaming. En un Cloud
             Run con 512 MB, un administrador subiendo un archivo de 2000 filas
             no puede ser lo que tumbe el contenedor (CLAUDE.md seccion 8).
             La linea 0.15.x es la ultima que sigue compilando contra Java 8. -->
        <dependency>
            <groupId>org.dhatim</groupId>
            <artifactId>fastexcel-reader</artifactId>
            <version>0.15.7</version>
        </dependency>
        <dependency>
            <groupId>org.dhatim</groupId>
            <artifactId>fastexcel</artifactId>
            <version>0.15.7</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- <release> es estricto: rechaza APIs > Java 8 (ej. String.isBlank).
                         Asegura paridad con la imagen docker (Temurin 8). -->
                    <release>8</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>exigir-jdk-moderno</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[9,)</version>
                                    <!-- La opcion "release" del compilador existe desde el
                                         JDK 9. Con un JDK 8 el build muere con un error
                                         criptico de bandera invalida; este mensaje lo evita. -->
                                    <message>Compila con JDK 9+ (el Dockerfile usa 17). El bytecode sale para Java 8 via la opcion release del compilador.</message>
                                </requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
